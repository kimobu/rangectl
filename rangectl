#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${ROOT}:${PYTHONPATH:-}"

if ! command -v uv >/dev/null 2>&1; then
  echo "ERROR: uv is required to run rangectl" >&2
  echo "Install uv, then rerun this command from ${ROOT}" >&2
  exit 127
fi

exec uv run --project "${ROOT}" python "${ROOT}/cmd/rangectl/main.py" "$@"

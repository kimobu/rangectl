[Unit]
Description=Socat redirector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:{{ item.listen_port }},bind={{ item.listen_addr }},{{ item.socket_options | default('reuseaddr,fork') }} TCP:{{ item.target_host }}:{{ item.target_port }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

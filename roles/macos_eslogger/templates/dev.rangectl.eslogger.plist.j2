<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ macos_eslogger_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec /usr/bin/eslogger {{ macos_eslogger_supported_events | join(' ') }} &gt;&gt; {{ macos_eslogger_log_path }} 2&gt;&gt; {{ macos_eslogger_error_log_path }}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{ macos_eslogger_error_log_path }}</string>
  <key>StandardErrorPath</key>
  <string>{{ macos_eslogger_error_log_path }}</string>
  <key>WorkingDirectory</key>
  <string>/var/log</string>
</dict>
</plist>

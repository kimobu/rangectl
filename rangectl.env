# Copy this file to .rangectl.env and uncomment the values needed for your range.
# .rangectl.env is intentionally ignored by git because it may contain secrets.

## Content packs
# RANGECTL_CONTENT_DIRS=/path/to/lab-content:/srv/rangectl-packs

## Proxmox API
# PROXMOX_VE_ENDPOINT=https://proxmox.example.test:8006
# PROXMOX_VE_API_TOKEN=user@pam!tokenid=secret
# PROXMOX_VE_USERNAME=root@pam
# PROXMOX_VE_PASSWORD=secret
# PROXMOX_VE_CA_FILE=/path/to/proxmox-ca.pem
## Lab-only escape hatch for self-signed endpoints without a configured CA.
# PROXMOX_VE_INSECURE=false

## Proxmox render defaults
# PROXMOX_NODE=pve1
# PROXMOX_POOL=rangectl
# PROXMOX_STORAGE=local-lvm
# PROXMOX_PFSENSE_STORAGE=local-lvm
# PROXMOX_LXC_STORAGE=local-lvm
# PROXMOX_FULL_CLONE=true
# PROXMOX_NETWORK_BRIDGE=vmbr0
# PROXMOX_NETWORK_SPAN_BRIDGE=vmbr1

## Terraform/OpenTofu execution
## Lower this for large Proxmox ranges if clone tasks overload the API.
# RANGECTL_TERRAFORM_PARALLELISM=2
## Skip providers for local-only runs, for example: aws or aws,azure.
# RANGECTL_SKIP_PROVIDERS=aws

## Direct Terraform/OpenTofu Proxmox overrides
# TF_VAR_pm_node=pve1
# TF_VAR_pm_pool=rangectl
# TF_VAR_storage=local-lvm
# TF_VAR_pfsense_storage=local-lvm
# TF_VAR_lxc_storage=local-lvm
# TF_VAR_pm_full_clone=true
# TF_VAR_network_bridge=vmbr0
# TF_VAR_network_span_bridge=vmbr1

## Template build tooling
# RANGECTL_TEMPLATE_CACHE_DIR=/var/cache/rangectl/templates
# RANGECTL_PACKER_BIN=packer
# RANGECTL_XORRISO_BIN=xorriso
# RANGECTL_PROXMOX_SSH_HOST=proxmox.example.test
# RANGECTL_PROXMOX_SSH_USER=root
# RANGECTL_PROXMOX_SSH_KEY=/path/to/proxmox-root-key
## Normal SSH known-host verification is enabled by default.
# RANGECTL_SSH_KNOWN_HOSTS=/path/to/known_hosts
# RANGECTL_SSH_INSECURE=false
# RANGECTL_TEMPLATE_WINDOWS_ADMIN_PASSWORD=change-me

## AWS
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

## Tart macOS hosts
# TART_HOST=mac-mini.example.test
# TART_USER=admin
# TART_SSH_KEY=/path/to/tart-host-key
# TART_SSH_PORT=22
# TART_BIN=/opt/homebrew/bin/tart

## Jump Desktop Connect
# JUMP_DESKTOP_CONNECT_CODE=replace-with-your-connect-code

## Activity simulation local state
# RANGECTL_ACTIVITY_STATE_DIR=/path/to/activity/state

## Large Windows telemetry artifacts
## Optional. Serve artifacts/securityonion with a local HTTP server and point
## this at so-elastic-agent_windows_amd64.exe to avoid slow WinRM copies.
# RANGECTL_WINDOWS_ELASTIC_AGENT_URL=http://rangectl-controller.example.test:8765/so-elastic-agent_windows_amd64.exe
# RANGECTL_WINDOWS_ELASTIC_AGENT_SHA256=sha256-of-so-elastic-agent_windows_amd64.exe

## Activity simulation email backend
# ACTIVITY_IMAP_HOST=mail.example.test
# ACTIVITY_IMAP_PORT=993
# ACTIVITY_IMAP_SSL=true
# ACTIVITY_SMTP_HOST=mail.example.test
# ACTIVITY_SMTP_PORT=587
# ACTIVITY_SMTP_SSL=starttls
# ACTIVITY_MAIL_USERNAME=bot@example.test
# ACTIVITY_MAIL_PASSWORD=secret

## Activity simulation AI content provider
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

## Ansible
# ANSIBLE_CONFIG=/path/to/ansible.cfg
# ANSIBLE_ROLES_PATH=/path/to/roles
